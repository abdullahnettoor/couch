{
  "name": "couch",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "dist/main/index.mjs",
  "scripts": {
    "build:native": "sh native/mpv-embed/build.sh",
    "build": "sh native/mpv-embed/build.sh && vp build && vp pack && node scripts/write-remote-page.mjs",
    "start": "vp run build && node scripts/dev-electron.mjs",
    "package": "vp run build && node scripts/package.mjs",
    "postinstall": "node scripts/ensure-electron.mjs",
    "sign:dev": "node scripts/sign-dev.mjs",
    "webkit-selftest": "node scripts/media-remote-selftest.mjs && node scripts/webkit-selftest.mjs && node scripts/webkit-cookies-check.mjs",
    "webkit-test-page-check": "node scripts/webkit-test-page-check.mjs",
    "webkit-cookies-check": "node scripts/webkit-cookies-check.mjs",
    "drm-check": "node scripts/drm-check/run.mjs",
    "sample": "sh scripts/make-sample.sh",
    "icons": "sh scripts/make-icons.sh",
    "photos:real": "node scripts/run-real-photos.mjs",
    "listener": "sh listener/build.sh",
    "listener:test": "vp run listener && node --test listener/test/run.mjs",
    "check": "vp check",
    "test": "vp test run"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "electron": "github:castlabs/electron-releases#v44.5.1+wvcus",
    "happy-dom": "^21.0.4",
    "typescript": "~7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  }
}
