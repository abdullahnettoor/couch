{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "couch-site",
  "compatibility_date": "2025-11-01",
  // Static assets only: no Worker script. Every request is a file from dist/ (Vite's output), or the 404 page.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Version URLs (previews on the account's workers.dev subdomain) are off: Cloudflare can't delete single versions, so
  // turning them off is what takes old previews offline. Turning them back on brings every old version's URL back; for a
  // throwaway preview, prefer `npx wrangler preview --name <name>` and `npx wrangler preview delete --name <name>` (which
  // also needs this on). The Worker's own workers.dev address stays off.
  "preview_urls": false,
  "routes": [{ "pattern": "couch.abdullahnettoor.com", "custom_domain": true }]
}
