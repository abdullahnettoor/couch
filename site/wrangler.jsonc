{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "couch-site",
  "compatibility_date": "2025-11-01",
  // Static assets only: no Worker script. Every request is a file from dist/ (Vite's output), or the 404 page.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Preview links for non-production branches (Workers Builds), on the account's workers.dev subdomain; the Worker's own
  // workers.dev address stays off.
  "preview_urls": true,
  "routes": [{ "pattern": "couch.abdullahnettoor.com", "custom_domain": true }]
}
