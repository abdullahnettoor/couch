{
  "name": "couch-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc --noEmit && node scripts/launch-thumb.mjs && vite build",
    "preview": "vite preview --port 4173",
    "sync:couch": "node scripts/sync-couch-ui.mjs",
    "test": "node scripts/css-scope.test.mjs && node scripts/wordmark.mjs --check && node --test src/brand/ scripts/launch-thumb.test.mjs && node --test scripts/intro.test.mjs && node --test scripts/page.test.mjs && node --test scripts/launch.test.mjs",
    "wordmark": "node scripts/wordmark.mjs",
    "wordmark:font": "node scripts/korataki.mjs",
    "shots": "node scripts/shots.mjs",
    "launch:thumb": "node scripts/launch-thumb.mjs",
    "grain": "node scripts/grain.mjs",
    "deploy": "pnpm build && wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "geist": "^1.9.0",
    "lighthouse": "^13.6.0",
    "opentype.js": "^2.0.0",
    "puppeteer-core": "^25.16.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.156.0"
  },
  "license": "GPL-3.0-or-later"
}
